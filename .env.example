# ============================================================
# VARSHA-Q Environment Configuration
# ============================================================

# Operational Mode: 'LIVE', 'RESEARCH', 'DEMO'
VARSHA_MODE=DEMO

# Hardware Compute Device: 'auto', 'cuda', 'cpu'
DEVICE=auto

# Database: Async SQLite (Default zero-config) or PostgreSQL/PostGIS
DATABASE_URL=sqlite+aiosqlite:///./varsha_q.db
# For PostgreSQL/PostGIS:
# DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/varsha_q

# IMD (India Meteorological Department) Official API Credentials
# Leave empty to run in synchronized offline demonstration mode
IMD_API_KEY=
IMD_BASE_URL=https://api.imd.gov.in/v1
IMD_TIMEOUT_SEC=3.5

# Numerical Weather Prediction (NWP) Open Ingestion
OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast

# Pipeline Ingestion Interval
INGESTION_INTERVAL_MINUTES=15
